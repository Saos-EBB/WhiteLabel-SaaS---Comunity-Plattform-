# Browser-facing (baked into the client bundle) — the backend port published to the host
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Server-to-server (Next.js server, e.g. the /uploads rewrite in next.config.ts).
# Plain localhost when the frontend runs directly on the host.
# docker-compose overrides this to http://nestjs:3000 for the containerized frontend.
BACKEND_INTERNAL_URL=http://localhost:3000
